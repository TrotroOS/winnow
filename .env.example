# Copy to `.env` for docker compose or local ops. Never commit real values.

# --- Kill switch & feature flags ---
# Blocks scheduler and all outbound sends when true (1, true, yes).
WINNOW_HALT=

# Allow generative criteria proposals (off by default).
WINNOW_ALLOW_GENERATIVE=

# --- Persistence (container defaults use /data and /logs) ---
WINNOW_DB_PATH=/data/winnow.sqlite
WINNOW_DATA_DIR=/data
WINNOW_LOGS_DIR=/logs

# --- Email transport (required for `send-batch --confirm` only) ---
# sendgrid | ses
WINNOW_EMAIL_PROVIDER=
SENDGRID_API_KEY=

# Amazon SES (when WINNOW_EMAIL_PROVIDER=ses)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_REGION=

# --- LinkedIn transport (manual routing; token required if channel is linkedin) ---
LINKEDIN_ACCESS_TOKEN=

# --- Source adapters (set when you register paid HTTP sources) ---
WINNOW_MOCK_FIXTURE_PATH=
# APOLLO_API_KEY=
# CLEARBIT_API_KEY=

# --- Optional metrics sidecar ---
WINNOW_METRICS=0
WINNOW_METRICS_HOST=127.0.0.1
WINNOW_METRICS_PORT=9100

# --- Compliance (edit config YAML on disk; not loaded from env today) ---
# In config.yaml / config_community.yaml set for live email:
#   sender_identity
#   physical_address   (CAN-SPAM / postal compliance)
#   unsubscribe_url    (per-candidate via {candidate_id})
#   email_from
# tracking_pixel_enabled should stay false unless you accept pixel tracking risk.
